# Server
PORT=3000

# Meta / WhatsApp Cloud API
WEBHOOK_VERIFY_TOKEN=a-secret-string-you-choose
WHATSAPP_TOKEN=access-token-for-the-meta-app
PHONE_NUMBER_ID=whatsapp-business-phone-number-id
# App Secret of your Meta app (Basic settings → App secret).
# Used to verify the X-Hub-Signature-256 signature of each incoming webhook.
WHATSAPP_APP_SECRET=meta-app-secret

# LLM — any OpenAI-compatible endpoint. Pick one:
#
# Groq (prod, fast, pay-as-you-go):
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
#
# Local Ollama (free, for development, no internet required):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Optional. Minutes a duplicate-confirmation question stays pending before it
# expires (default 30). If the user doesn't reply within that time, their
# next message is treated as a new one.
# VENTANA_CONFIRMACION_MIN=30
