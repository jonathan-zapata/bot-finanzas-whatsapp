# Server
PORT=3000

# Meta / WhatsApp Cloud API
WEBHOOK_VERIFY_TOKEN=a-secret-string-you-choose
WHATSAPP_TOKEN=access-token-for-the-meta-app
PHONE_NUMBER_ID=whatsapp-business-phone-number-id
# App Secret of your Meta app (Basic settings → App secret).
# Used to verify the X-Hub-Signature-256 signature of each incoming webhook.
WHATSAPP_APP_SECRET=meta-app-secret

# LLM — any OpenAI-compatible endpoint. Pick one:
#
# Groq (prod, fast, pay-as-you-go). llama-3.3-70b-versatile follows the
# structured-extraction instructions much more reliably than the 8b model;
# swap to llama-3.1-8b-instant only if you need lower latency and can accept
# more inconsistent output:
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
#
# Local Ollama (free, for development, no internet required):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Optional. Minutes a duplicate-confirmation question stays pending before it
# expires (default 30). If the user doesn't reply within that time, their
# next message is treated as a new one.
# VENTANA_CONFIRMACION_MIN=30

# ── Email agent (optional) ──────────────────────────────────────────────────
# Only needed to connect a personal Microsoft (Hotmail/Outlook) mailbox. The
# bot boots and the expense flow works without any of these. Phase 1 requests
# ONLY read scopes (Mail.Read + MailboxSettings.Read), so read-only is enforced
# by Microsoft. Register an Azure AD app of type "Personal accounts only".
# MS_CLIENT_ID=azure-app-application-client-id
# MS_CLIENT_SECRET=azure-app-client-secret
# Must EXACTLY match the redirect URI registered on the Azure app, pointing at
# this service's callback route:
# MS_REDIRECT_URI=https://your-service-url/oauth/microsoft/callback
# "consumers" for personal accounts (default). Leave as-is for Hotmail/Outlook.
# MS_TENANT=consumers
# GCP project that holds Secret Manager, and the secret id for the (rotating)
# Microsoft refresh token. Cloud Run's service account needs secretAccessor +
# secretVersionAdder on this secret. Default id: ms-refresh-token.
# GCP_PROJECT_ID=your-gcp-project-id
# MS_REFRESH_TOKEN_SECRET=ms-refresh-token
