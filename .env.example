# Servidor
PORT=3000

# Meta / WhatsApp Cloud API
WEBHOOK_VERIFY_TOKEN=un-string-secreto-que-vos-elijas
WHATSAPP_TOKEN=token-de-acceso-de-la-app-de-meta
PHONE_NUMBER_ID=id-del-numero-de-whatsapp-business
# App Secret de tu app de Meta (Configuración básica → Secreto de la app).
# Se usa para verificar la firma X-Hub-Signature-256 de cada webhook entrante.
WHATSAPP_APP_SECRET=app-secret-de-meta

# LLM — cualquier endpoint compatible con OpenAI. Elegí uno:
#
# Groq (prod, rápido, de pago por uso):
LLM_API_KEY=tu-api-key-de-groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
#
# Ollama local (gratis, para desarrollo, sin salir a internet):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-o-anon-key
